---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import page from '../../data/blog.json';
import { published, pad } from '../../lib/content';
import { url } from '../../lib/url';

const posts = await published('blog');
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<Base title={page.meta.title} description={page.meta.description} active="blog" left={{ title: page.pageLeft.titleParts, sub: page.pageLeft.sub }}>
    <section class="section page-list">
        <div class="container">
            <p class="page-intro" data-reveal>{page.hero.desc}</p>
            {
                posts.length ? (
                    <ol class="card-list" data-reveal>
                        {posts.map((p, i) => (
                            <Card
                                num={pad(i + 1)}
                                title={p.data.title ?? p.id}
                                brief={p.data.brief}
                                tags={[...p.data.tags, fmt(p.data.date)]}
                                href={url(`/blog/${p.id}/`)}
                                heading="h2"
                            />
                        ))}
                    </ol>
                ) : (
                    <p class="empty-state">The first posts are being written. Meanwhile, the Knowledge base is full of in-depth articles.</p>
                )
            }
        </div>
    </section>
</Base>
