---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import LayoutToggle from '../../components/LayoutToggle.astro';
import page from '../../data/knowledge.json';
import { published, PHASES, pad } from '../../lib/content';
import { url } from '../../lib/url';
import { render } from 'astro:content';

const all = await published('knowledge');
const items = await Promise.all(
    all.map(async (e, i) => {
        const { remarkPluginFrontmatter: fm } = await render(e);
        return { e, num: pad(i + 1), minutes: fm.coreMinutes as number };
    })
);
const phases = PHASES.map((name, i) => ({ name, n: i + 1, items: items.filter((x) => x.e.data.phase === i + 1) })).filter(
    (p) => p.items.length
);
---

<Base title={page.meta.title} description={page.meta.description} active="knowledge" left={{ title: page.pageLeft.titleParts, sub: page.pageLeft.sub }}>
    <section class="section page-list">
        <div class="container">
            <p class="page-intro" data-reveal>{page.hero.desc}</p>
            {
                phases.map((p, i) => (
                    <div class="phase">
                        <div class="section-header" data-reveal>
                            <h2 class="section__label">
                                <span class="phase__num">Phase {p.n}</span> {p.name}
                            </h2>
                            {i === 0 && <LayoutToggle />}
                        </div>
                        <ol class="card-list" data-reveal>
                            {p.items.map(({ e, num, minutes }) => (
                                <Card
                                    num={num}
                                    title={e.data.title}
                                    brief={e.data.brief}
                                    tags={[...e.data.tags, `${minutes} min read`]}
                                    href={url(`/knowledge/${e.id}/`)}
                                />
                            ))}
                        </ol>
                    </div>
                ))
            }
        </div>
    </section>
</Base>
