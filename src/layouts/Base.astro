---
import '../styles/main.css';
import Icon from '../components/Icon.astro';
import nav from '../data/nav.json';
import { published } from '../lib/content';
import { url } from '../lib/url';

interface Props {
    title: string;
    description: string;
    /* nav key of the current section, e.g. "knowledge" */
    active?: string;
    /* split layout: decorative left column with the page title */
    left?: { title: string[]; sub: string };
}
const { title, description, active, left } = Astro.props;

/* Hide a section from the nav while it has nothing published */
const hasBlog = (await published('blog')).length > 0;
const links = nav.links.filter((l) => l.key !== 'blog' || hasBlog);
const leftLinks = links.slice(0, 3);
const rightLinks = links.slice(3);
const isHome = active === 'about';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
        <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,700;1,8..60,400&family=JetBrains+Mono:wght@400;500;700&display=swap"
            rel="stylesheet"
        />
        <script is:inline>
            /* apply the saved theme before first paint */
            try {
                var t = localStorage.getItem('theme');
                if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
            } catch (_) {}
        </script>
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to content</a>
        <div class="page-frame">
            <div class="bg-grid" aria-hidden="true"></div>

            <nav id="nav" class="nav" aria-label="Main navigation">
                <div class="nav__inner container">
                    <ul class="nav__links">
                        {
                            leftLinks.map((l) => (
                                <li>
                                    <a
                                        href={url(l.href)}
                                        class:list={['nav__link', { active: l.key === active }]}
                                        aria-current={l.key === active ? 'page' : undefined}
                                    >
                                        {l.label}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                    {
                        isHome && (
                            <a href={url('/')} class="nav__logo" aria-label={nav.brand.ariaLabel}>
                                <span class="nav__logo-name">{nav.brand.name}</span>
                            </a>
                        )
                    }
                    <div class="nav__right">
                        <ul class="nav__links">
                            {
                                rightLinks.map((l) => (
                                    <li>
                                        <a
                                            href={url(l.href)}
                                            class:list={['nav__link', { active: l.key === active }]}
                                            aria-current={l.key === active ? 'page' : undefined}
                                        >
                                            {l.label}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                        <div class="nav__actions">
                            <button class="theme-toggle" id="theme-toggle" aria-label="Toggle colour theme">
                                <Icon name="sun" size={18} class="icon-sun" />
                                <Icon name="moon" size={18} class="icon-moon" />
                            </button>
                            <a href={url(nav.cta.href)} class="btn btn--sm btn--gray">{nav.cta.label}</a>
                        </div>
                    </div>
                    <button class="nav__burger" id="nav-burger" aria-label="Toggle menu" aria-expanded="false">
                        <span></span><span></span><span></span>
                    </button>
                </div>
                <div class="nav__dropdown" id="nav-dropdown">
                    {
                        links.map((l) => (
                            <a href={url(l.href)} class:list={['nav__link', { active: l.key === active }]}>
                                {l.label}
                            </a>
                        ))
                    }
                </div>
            </nav>

            <div class="page-body">
                {
                    left && (
                        <div class="page-aside">
                            <h1 class="page-aside__title">
                                {left.title.map((part, i) => (
                                    <>
                                        {i > 0 && ' '}
                                        {i > 0 && <br />}
                                        {part}
                                    </>
                                ))}
                            </h1>
                            <p class="page-aside__sub">{left.sub}</p>
                        </div>
                    )
                }
                <div class="page-main page-main--wide" id="page-main">
                    <main id="main">
                        <slot />
                    </main>
                    <footer class="footer">
                        <div class="container">
                            <div class="footer__inner">
                                <p class="footer__copy">{nav.footer.copy.replace('{year}', String(year))}</p>
                                <p class="footer__sig">{nav.footer.sig}</p>
                            </div>
                        </div>
                    </footer>
                </div>
            </div>
        </div>
        <script>
            import '../scripts/site.ts';
        </script>
    </body>
</html>
